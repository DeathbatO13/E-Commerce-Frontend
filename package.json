{
  "name": "e-commerce-frontend",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "shell",
    "auth-app",
    "catalog-app",
    "cart-app",
    "orders-app",
    "admin-app"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "concurrently -k --names shell,auth,catalog,cart,orders,admin \"npm run dev --workspace=shell\" \"npm run dev --workspace=auth-app\" \"npm run dev --workspace=catalog-app\" \"npm run dev --workspace=cart-app\" \"npm run dev --workspace=orders-app\" \"npm run dev --workspace=admin-app\"",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "turbo": "^2.5.4"
  }
}
