{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.*", "eslint.config.js"],
  "globalEnv": ["VITE_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}
